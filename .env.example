###############################################################################
# Application
###############################################################################
APP_NAME="Renewal Guard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Every date in this system is an Indian business date. Do not change this
# without re-reading how `expires_at` and the reminder windows are compared.
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL 8 locally, MariaDB on Hostinger shared hosting
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=renewal_guard
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Session, cache and queue
#
# Shared hosting has no Redis and no Supervisor, so all three run on the
# database. The queue is drained by a cron job (see README), not a daemon.
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local

###############################################################################
# Broadcasting — Pusher Channels
#
# The Pusher protocol is what Laravel Echo speaks, so moving to a self-hosted
# Reverb server later is an env change, not a code change.
###############################################################################
BROADCAST_CONNECTION=null

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

###############################################################################
# Mail — Mailpit locally, Postmark in production
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="alerts@example.com"
MAIL_FROM_NAME="${APP_NAME}"

POSTMARK_TOKEN=
POSTMARK_MESSAGE_STREAM_ID=outbound

###############################################################################
# Web push (phase 4). Generate with: php artisan webpush:vapid
###############################################################################
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:alerts@example.com"

###############################################################################
# WhatsApp Cloud API (phase 5). The channel no-ops when these are blank.
###############################################################################
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=renewal_reminder

###############################################################################
# Operations
#
# HEALTHCHECK_URL is pinged at the end of every successful reminder run. If the
# cron stops firing, the external service raises the alarm — this app cannot
# alert you about its own silence.
###############################################################################
HEALTHCHECK_URL=
REMINDER_SEND_TIME=09:00

###############################################################################
# Media and backups (S3 or Cloudflare R2)
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
